# hal_sensors_default.te

allow hal_sensors_default iio_device:chr_file r_file_perms;
allow hal_sensors_default sensor_device:chr_file rw_file_perms;

allow hal_sensors_default {
    app_efs_file
    efs_file
}:dir search;

allow hal_sensors_default {
    app_efs_file
    baro_delta_factoryapp_efs_file
    sensor_factoryapp_efs_file
    sysfs_batteryinfo
}:file r_file_perms;

allow hal_sensors_default {
    sysfs_grip
    sysfs_hrm
    sysfs_spi_writeable
    sysfs_ssp
    sysfs_sensors
    sysfs_batteryinfo
    sysfs_input
    sysfs_battery
}:dir r_dir_perms;

allow hal_sensors_default {
    sysfs_grip
    sysfs_hrm
    sysfs_spi_writeable
    sysfs_ssp
}:file rw_file_perms;

allow hal_sensors_default {
    sysfs_sensors
    sysfs_input
    sysfs_battery
}:file r_file_perms;

allow hal_sensors_default {
    sysfs_grip
    sysfs_hrm
    sysfs_iio
}:lnk_file r_file_perms;

# 6.6: the BCM4773 hub's IIO devices. The HAL finds them through
# /sys/bus/iio/devices, sets their rate and buffers, and reads
# /dev/iio:deviceN.
allow hal_sensors_default sysfs_iio:dir r_dir_perms;
allow hal_sensors_default sysfs_iio:file r_file_perms;
allow hal_sensors_default sysfs_ssp_iio:dir r_dir_perms;
allow hal_sensors_default sysfs_ssp_iio:file rw_file_perms;
allow hal_sensors_default sysfs_ssp_iio:lnk_file r_file_perms;
get_prop(hal_sensors_default, vendor_sensors_nk_prop)

# The AIDL multihal calls back into the sensor service in system_server
# (dynamic sensor and death notifications).
binder_call(hal_sensors_default, system_server)
