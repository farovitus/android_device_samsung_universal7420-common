# kernel.te

allow kernel block_device:dir search;

# /dev/mbin0
allow kernel emmcblk_device:blk_file r_file_perms;

# /efs contents
allow kernel {
    app_efs_file
    battery_efs_file 
    efs_file 
    sensor_efs_file
    wifi_efs_file
    sysfs_battery
}:dir r_dir_perms;

allow kernel {
    app_efs_file
    battery_efs_file
    efs_file
    sensor_efs_file
    sensor_factoryapp_efs_file
    sysfs_batteryinfo
}:file rw_file_perms;

# /data/misc/conn/.wifiver.info
allow kernel wifi_data_file:file rw_file_perms;

# /sys/devices/system/cpu/cpu[0-9]/cpufreq/*
allow kernel sysfs_devices_system_cpu:file setattr;

allow kernel {
    sysfs_sec_key
    sysfs_ssp
    sysfs_batteryinfo
}:dir search;

allow kernel {
    sysfs_sec_key
    sysfs_ssp
}:file r_file_perms;

# Allow kernel to search tmpfs
allow kernel tmpfs:dir search;

allow kernel kernel:capability chown;
allow kernel self:capability { chown mknod sys_module};
allow kernel self:system module_request;


# The direct firmware loader reads brcmfmac firmware, its NVRAM and the
# regulatory database from /vendor/firmware, whose brcm/ entries link
# to the blobs in /vendor/etc/wifi.
allow kernel vendor_file:dir r_dir_perms;
allow kernel vendor_file:lnk_file read;
allow kernel vendor_file:file r_file_perms;
allow kernel vendor_configs_file:dir search;
allow kernel vendor_configs_file:file r_file_perms;
