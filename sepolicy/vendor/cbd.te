# cbd.te

allow cbd sysfs_socinfo:file r_file_perms;
allow cbd proc_net:file r_file_perms;

# /dev/umts_ramdump0 (CP dump), /dev/__cbd_msg_
allow cbd mif_device:chr_file rw_file_perms;

# /dev/mipi-lli -> the mipi-lli sysfs directory; cbd writes link commands
# to lli_control
allow cbd mif_device:lnk_file read;
allow cbd sysfs_mipi:file rw_file_perms;

#audit2allow
allow cbd sysfs:dir read;
allow cbd sysfs_modem:dir r_dir_perms;
allow cbd sysfs_modem:file rw_file_perms;
