# hal_power_default.te

allow hal_power_default{
    sysfs_backlight_writable
    sysfs_batteryinfo
    sysfs_devices_system_cpu
    sysfs_graphics
    sysfs_light
    sysfs_sec_tsp
    sysfs_power_writable
    sysfs_touchscreen_writable
}:dir r_dir_perms;

allow hal_power_default{
    pm_qos_device
    sysfs_backlight_writable
    sysfs_batteryinfo
    sysfs_devices_system_cpu
    sysfs_graphics
    sysfs_light
    sysfs_sec_tsp
    sysfs_input
    sysfs_touchscreen_writable
}:file rw_file_perms;

allow hal_power_default sysfs_sec_tsp:lnk_file read;

# Top-app utilisation clamp (/dev/cpuctl/top-app/cpu.uclamp.min).
# Android 13 does not enable the cgroup_seclabel policy capability, so
# cgroup v1 files cannot get their own genfscon type and the rule stays
# on cgroup. libperfmgr only opens, writes and (for dumpsys) reads it.
allow hal_power_default cgroup:dir search;
allow hal_power_default cgroup:file { getattr open read write };
