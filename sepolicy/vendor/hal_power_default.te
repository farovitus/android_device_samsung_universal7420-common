# hal_power_default.te

allow hal_power_default{
    sysfs_backlight_writable
    sysfs_batteryinfo
    sysfs_devices_system_cpu
    sysfs_graphics
    sysfs_light
    sysfs_power_writable
}:dir r_dir_perms;

allow hal_power_default{
    pm_qos_device
    sysfs_backlight_writable
    sysfs_batteryinfo
    sysfs_devices_system_cpu
    sysfs_graphics
    sysfs_light
    sysfs_input
}:file rw_file_perms;

# GPU devfreq floor (/sys/class/devfreq/14ac0000.gpu/min_freq).
allow hal_power_default sysfs_devfreq:dir r_dir_perms;
allow hal_power_default sysfs_devfreq:file rw_file_perms;

# Top-app utilisation clamp (/dev/cpuctl/top-app/cpu.uclamp.min).
allow hal_power_default cgroup:dir search;
allow hal_power_default cgroup:file rw_file_perms;
