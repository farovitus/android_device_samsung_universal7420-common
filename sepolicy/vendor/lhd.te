# lhd.te

allow lhd {
    efs_file
    sec_efs_file
}:dir search;

allow lhd {
    sysfs_lhd
    sysfs_sec_sensorhub
}:dir search;

allow lhd {
    sysfs_lhd
    sysfs_sec_sensorhub
    sysfs
}:file rw_file_perms;

allow lhd sysfs_sec_gps:lnk_file r_file_perms;

allow lhd gps_data_file:dir rw_dir_perms;
allow lhd gps_data_file:file create_file_perms;
allow lhd gps_data_file:fifo_file create_file_perms;

dontaudit lhd system_data_file:dir search;

# lhd opens inet sockets. bionic's connect() hands each one to netd's
# fwmarkd to mark it, so lhd needs the connect and netd needs to use the
# socket lhd passes (fd use, tcp_socket read/write/getopt/setopt). The
# common policy grants only the sock_file write. net_domain() is the
# AOSP grant for a domain that uses inet sockets and covers both sides.
net_domain(lhd)
