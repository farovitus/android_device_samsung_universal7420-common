#  hal_bluetooth_default.te

# /efs
allow hal_bluetooth_default efs_file:dir search;
r_dir_file(hal_bluetooth_default, bluetooth_efs_file)

allow hal_bluetooth_default vendor_firmware_file:dir r_dir_perms;

# btlinux takes hci0 over an HCI_CHANNEL_USER socket. net_admin,
# sys_nice and sysfs reads come from the AOSP hal_bluetooth rules.
# Its rfkill state write is not needed: the hci0 rfkill starts
# unblocked, and the HAL carries on when the write fails.
allow hal_bluetooth_default self:bluetooth_socket { create bind read write };
