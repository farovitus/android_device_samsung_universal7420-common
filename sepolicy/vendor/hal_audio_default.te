# hal_audio_default.te

allow hal_audio_default {
    efs_file
    sec_efs_file
    sysfs_earsmart
}:dir search;

allow hal_audio_default sec_efs_file:file r_file_perms;

allow hal_audio_default rild:unix_stream_socket connectto;

allow hal_audio_default sysfs_earsmart:file rw_file_perms;
allow hal_audio_default sysfs_earsmart:lnk_file read;

# Allow hal to take wakelock
wakelock_use(hal_audio_default)

get_prop(hal_audio_default, vendor_audio_prop)

# The proprietary libsecril-client.so in the audio HAL calls
# acquire_wake_lock(). libhardware_legacy looks up the AIDL ISystemSuspend
# through the process's service manager, which is vndservicemanager here
# because the service runs on /dev/vndbinder. ISystemSuspend is never
# registered there, so the lookup can only fail; granting it would make
# AServiceManager_waitForService() wait forever instead. Stop auditing it.
dontaudit hal_audio_default default_android_vndservice:service_manager find;
