# Audio
vendor_internal_prop(vendor_audio_prop);

# Camera
vendor_internal_prop(vendor_camera_prop);

# NFC
vendor_internal_prop(vendor_nfc_prop);

# Radio
vendor_internal_prop(clatd_radio_prop)

# Touchscreen
vendor_internal_prop(vendor_stmfts_prop)

# Mesa and minigbm debug options, read by every graphics client
vendor_restricted_prop(vendor_graphics_debug_prop)
get_prop({ domain -isolated_app }, vendor_graphics_debug_prop)

# Power HAL state
vendor_internal_prop(vendor_powerhal_prop)

# Sensors HAL calibration (persist.vendor.sensors.nk.*)
vendor_internal_prop(vendor_sensors_nk_prop)
