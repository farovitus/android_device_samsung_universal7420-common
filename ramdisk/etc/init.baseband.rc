on init
	mkdir /efs 0771 radio system
    symlink /dev/block/platform/15570000.ufs/by-name/RADIO /dev/mbin0
    restorecon /dev/mbin0

    # cbd sends link commands to lli_control through this link. On the NK
    # 6.6 kernel MMIO devices sit under the soc@0 bus.
    symlink /sys/devices/platform/soc@0/10f24000.mipi-lli /dev/mipi-lli
    restorecon /dev/mipi-lli

    # Receive packet steering for the modem interfaces goes to the A53s.
    # The stock masks (7, 4, 2) meant cpu0-2, cpu2 and cpu1, the little
    # cores in Samsung's numbering; on the 6.6 kernel the A53s are cpu0
    # and cpu5-7, so they map to 0x61 (cpu0,5,6), 0x40 (cpu6) and 0x20
    # (cpu5).
    write /sys/class/net/rmnet0/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet1/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet2/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet3/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet4/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet5/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet6/queues/rx-0/rps_cpus 61
    write /sys/class/net/rmnet7/queues/rx-0/rps_cpus 61
    write /proc/sys/net/core/netdev_max_backlog 5000

on fs
	chown radio system /efs
    chmod 0771 /efs
# MIF
    chown radio radio sys/devices/virtual/misc/multipdp/waketime
    chmod 0660 /sys/devices/virtual/misc/umts_dm0/dm_state
    chown radio system /sys/devices/virtual/misc/umts_dm0/dm_state
	
	# /efs/factory.prop for Dual / Single SIM settings
    chown radio radio /efs/factory.prop
    chmod 0600 /efs/factory.prop

on property:ril.clatd.v4-rmnet0=up
    write /sys/class/net/rmnet0/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet0/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet1=up
    write /sys/class/net/rmnet1/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet1/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet2=up
    write /sys/class/net/rmnet2/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet2/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet3=up
    write /sys/class/net/rmnet3/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet3/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet4=up
    write /sys/class/net/rmnet4/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet4/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet5=up
    write /sys/class/net/rmnet5/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet5/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet6=up
    write /sys/class/net/rmnet6/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet6/queues/rx-0/rps_cpus 20

on property:ril.clatd.v4-rmnet7=up
    write /sys/class/net/rmnet7/queues/rx-0/rps_cpus 40
    write /sys/class/net/v4-rmnet7/queues/rx-0/rps_cpus 20
    
# CP Boot Daemon (CBD)
service cpboot-daemon /vendor/bin/cbd -d -t ss333 -b s -m l -P platform/15570000.ufs/by-name/RADIO -n /efs
    class main
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log shell system

on property:ro.vendor.multisim.simslotcount=1
    setprop persist.radio.multisim.config ss

on property:ro.vendor.multisim.simslotcount=2
    setprop persist.radio.multisim.config dsds
