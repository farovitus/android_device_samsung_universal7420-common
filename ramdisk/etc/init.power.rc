on boot
    # cpufreq policies for the power HAL: policy0 is the Cortex-A53
    # cluster (cpu0,5-7), policy1 the Cortex-A57 cluster (cpu1-4).
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy1/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy1/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy1/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy1/scaling_min_freq

    # Top-app utilisation clamp for the power HAL's touch and launch boosts.
    chown system system /dev/cpuctl/top-app/cpu.uclamp.min
    chmod 0664 /dev/cpuctl/top-app/cpu.uclamp.min

    # GPU devfreq floor for the power HAL's launch and rendering boosts.
    chown system system /sys/class/devfreq/14ac0000.gpu/min_freq
    chmod 0664 /sys/class/devfreq/14ac0000.gpu/min_freq

    # cpusets. The A53 cores are cpu0,5-7 and the A57 cores cpu1-4.
    chown system system /dev/cpuset/top-app/cpus
    chown system system /dev/cpuset/foreground/cpus
    chown system system /dev/cpuset/background/cpus
    chown system system /dev/cpuset/system-background/cpus
    chown system system /dev/cpuset/restricted/cpus
    chmod 664 /dev/cpuset/top-app/cpus
    chmod 664 /dev/cpuset/foreground/cpus
    chmod 664 /dev/cpuset/background/cpus
    chmod 664 /dev/cpuset/system-background/cpus
    chmod 666 /dev/cpuset/restricted/cpus
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/top-app/mems 0
    write /dev/cpuset/foreground/cpus 0-6
    write /dev/cpuset/foreground/mems 0
    write /dev/cpuset/background/cpus 0,5
    write /dev/cpuset/background/mems 0
    write /dev/cpuset/system-background/cpus 0,5-6
    write /dev/cpuset/system-background/mems 0
    write /dev/cpuset/restricted/cpus 0,5-7

    # DT2W
    chown system system /sys/class/dt2w/enabled
    chmod 0644 /sys/class/dt2w/enabled
